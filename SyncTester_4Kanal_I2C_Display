#include <Wire.h>
#include <Adafruit_BMP280.h>
#include <LiquidCrystal_I2C.h>

#define TCA_ADDR 0x70      // Adresse des TCA9548A
#define LCD_ADDR 0x25      // LCD-Adresse (I2C)
#define NUM_SENSORS 4

Adafruit_BMP280 bmp;
LiquidCrystal_I2C lcd(LCD_ADDR, 20, 4);
float pressure[NUM_SENSORS];

// Custom Characters für Balkenanzeige
byte barChars[8][8] = {
  {0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00},  // leer
  {0x10,0x10,0x10,0x10,0x10,0x10,0x10,0x10},  // 1/8
  {0x18,0x18,0x18,0x18,0x18,0x18,0x18,0x18},  // 2/8
  {0x1C,0x1C,0x1C,0x1C,0x1C,0x1C,0x1C,0x1C},  // 3/8
  {0x1E,0x1E,0x1E,0x1E,0x1E,0x1E,0x1E,0x1E},  // 4/8
  {0x1F,0x1F,0x1F,0x1F,0x1F,0x1F,0x1F,0x1F},  // 5/8
  {0x1F,0x1F,0x1F,0x1F,0x1F,0x1F,0x1F,0x1F},  // 6/8
  {0x1F,0x1F,0x1F,0x1F,0x1F,0x1F,0x1F,0x1F}   // 7/8
};

void tcaSelect(uint8_t channel) {
  if (channel > 7) return;
  Wire.beginTransmission(TCA_ADDR);
  Wire.write(1 << channel);
  Wire.endTransmission();
}

void setup() {
  Wire.begin();
  lcd.init();
  lcd.backlight();

  for (int i = 0; i < 8; i++) {
    lcd.createChar(i, barChars[i]);
  }

  for (int i = 0; i < NUM_SENSORS; i++) {
    tcaSelect(i);
    if (!bmp.begin(0x76)) {
      lcd.setCursor(0, i);
      lcd.print("Sensor ");
      lcd.print(i);
      lcd.print(" ERR");
    }
  }
}

void loop() {
  for (int i = 0; i < NUM_SENSORS; i++) {
    tcaSelect(i);
    pressure[i] = bmp.readPressure() / 100.0F;
  }

  for (int i = 0; i < NUM_SENSORS; i++) {
    float p = pressure[i];
    char line[21];
    memset(line, ' ', 20);
    line[20] = '\0';

    float scale = (p - 600.0) / (1050.0 - 600.0);
    scale = constrain(scale, 0.0, 1.0);
    int totalBars = scale * 80;
    int full = totalBars / 8;
    int part = totalBars % 8;

    for (int j = 0; j < full; j++) {
      line[j] = 5;
    }
    if (full < 10 && part > 0) {
      line[full] = part;
    }

    // Ganzzahlige Ausgabe (gerundet)
    int pRounded = round(p);
    char val[6];
    sprintf(val, "%4d", pRounded);
    memcpy(&line[11], val, strlen(val));

    lcd.setCursor(0, i);
    lcd.print(line);
  }

  delay(500);
}
